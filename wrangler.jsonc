{
  // Cloudflare Workers with static assets. No build step: the site is the ./public folder.
  "name": "leeds-intelligence-society",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
